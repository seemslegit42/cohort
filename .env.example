# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="localhost"

# Appwrite Configurations
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://tor.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="6990e2830030cacccd98"
NEXT_PUBLIC_APPWRITE_DATABASE_ID="crm-main"

# Node-Appwrite Server SDK API Key (required ONLY for scripts/setup-database.js script)
APPWRITE_API_KEY=""

APPWRITE_PROJECT_ID="6990e2830030cacccd98"
APPWRITE_PROJECT_NAME="lxv"
APPWRITE_ENDPOINT="https://tor.cloud.appwrite.io/v1"
APPWRITE_API_KEY=""

# Agent / AI persistence (@libsql/client + agentfs-sdk). CRM data stays on Appwrite only.
AGENT_DEFAULT_TENANT="laevos-crm"
# Local dev / single VPS (default): omit AGENT_LIBSQL_URL or use file: — `.agentfs/{tenant}.db`
# AGENTFS_DIR=".agentfs"
# AGENT_LIBSQL_URL="file:.agentfs/laevos-crm.db"
# Production / multi-instance: Turso Cloud (centralized LibSQL, avoids per-replica SQLite locks)
# AGENT_LIBSQL_URL="libsql://your-db.turso.io"
# AGENT_LIBSQL_AUTH_TOKEN=""
# Legacy remote LibSQL env names (still supported)
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""